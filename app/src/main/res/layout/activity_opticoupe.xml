<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_space"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/hero_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="30dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/avatar_circle"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="✂️ Optimisation de coupe"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Paramètres Lo / Le / kerf -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0C1426"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Barre Lo" android:textColor="#8A97C2" android:textSize="11sp" />
            <EditText android:id="@+id/inLo" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/field_bg" android:inputType="numberDecimal" android:text="600"
                android:paddingHorizontal="10dp" android:paddingVertical="8dp"
                android:textColor="#EAF2FF" android:textSize="14sp" />
        </LinearLayout>

        <View android:layout_width="8dp" android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Chute max Le" android:textColor="#8A97C2" android:textSize="11sp" />
            <EditText android:id="@+id/inLe" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/field_bg" android:inputType="numberDecimal" android:hint="0"
                android:paddingHorizontal="10dp" android:paddingVertical="8dp"
                android:textColor="#EAF2FF" android:textColorHint="#5A688F" android:textSize="14sp" />
        </LinearLayout>

        <View android:layout_width="8dp" android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Trait scie" android:textColor="#8A97C2" android:textSize="11sp" />
            <EditText android:id="@+id/inKerf" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/field_bg" android:inputType="numberDecimal" android:text="0"
                android:paddingHorizontal="10dp" android:paddingVertical="8dp"
                android:textColor="#EAF2FF" android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingTop="8dp"
        android:text="Lo, Le, trait de scie et longueurs dans la MÊME unité (cm ou mm). Le ≤ plus petite pièce."
        android:textColor="#5A688F"
        android:textSize="11sp" />

    <!-- En-tête tableau -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2"
            android:text="Longueur" android:textColor="#8A97C2" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Qté" android:textColor="#8A97C2" android:textSize="12sp" android:textStyle="bold" />
        <View android:layout_width="36dp" android:layout_height="1dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:id="@+id/rowsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/btnAddRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/field_bg"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="+ Ajouter une longueur"
                android:textColor="#21E6FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- Boutons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/field_bg"
            android:gravity="center"
            android:paddingVertical="14dp"
            android:text="Effacer"
            android:textColor="#8A97C2"
            android:textSize="15sp" />

        <View android:layout_width="10dp" android:layout_height="1dp" />

        <TextView
            android:id="@+id/btnCalc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:background="@drawable/btn_primary"
            android:gravity="center"
            android:paddingVertical="14dp"
            android:text="✂️ Calculer"
            android:textColor="#08101F"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
