<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_space"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/hero_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="30dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/avatar_circle"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="💰 Kaonty"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Sélecteur de date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E9EDF5"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/btnPrevDay"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/avatar_circle"
            android:gravity="center"
            android:text="‹"
            android:textColor="#18202E"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/dateLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📅 —"
            android:textColor="#18202E"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnNextDay"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/avatar_circle"
            android:gravity="center"
            android:text="›"
            android:textColor="#18202E"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- Deux soldes séparés -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Solde Aluminium -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/glass_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔩 ALUMINIUM"
                android:textColor="#21E6FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/soldeAlu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0 Ar"
                android:textColor="#21E6FF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detailAlu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="+0 / -0"
                android:textColor="#6A7488"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/volaAlu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/field_bg"
                android:hint="Vola omaly"
                android:inputType="numberDecimal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:textColor="#18202E"
                android:textColorHint="#97A0B2"
                android:textSize="13sp" />
        </LinearLayout>

        <View android:layout_width="10dp" android:layout_height="1dp" />

        <!-- Solde Plateaux -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/glass_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟫 PLATEAUX"
                android:textColor="#FFC34D"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/soldePlateaux"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0 Ar"
                android:textColor="#FFC34D"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detailPlateaux"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="+0 / -0"
                android:textColor="#6A7488"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/volaPlateaux"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/field_bg"
                android:hint="Vola omaly"
                android:inputType="numberDecimal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:textColor="#18202E"
                android:textColorHint="#97A0B2"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Boutons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/btnIn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/btn_primary"
            android:gravity="center"
            android:paddingVertical="14dp"
            android:text="➕ Versement"
            android:textColor="#08101F"
            android:textSize="15sp"
            android:textStyle="bold" />

        <View android:layout_width="10dp" android:layout_height="1dp" />

        <TextView
            android:id="@+id/btnOut"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/btn_primary"
            android:gravity="center"
            android:paddingVertical="14dp"
            android:text="➖ Sortie"
            android:textColor="#08101F"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/listContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:text="Aucune opération\n\nAjoutez un versement ou une sortie"
                android:textColor="#6A7488"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
