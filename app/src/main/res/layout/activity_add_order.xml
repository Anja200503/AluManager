<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_space"
    android:orientation="vertical">

    <!-- Barre du haut -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/hero_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="28dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/avatar_circle"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/screenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Ajouter une commande"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/avatar_circle"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="Prix"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Stats -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EEF1F6"
        android:orientation="horizontal"
        android:paddingVertical="14dp">

        <LinearLayout style="@style/OStat">
            <TextView android:id="@+id/statProduits" style="@style/OStatVal" android:text="0" />
            <TextView style="@style/OStatLbl" android:text="Produits" />
        </LinearLayout>
        <LinearLayout style="@style/OStat">
            <TextView android:id="@+id/statLignes" style="@style/OStatVal" android:text="0" />
            <TextView style="@style/OStatLbl" android:text="Lignes" />
        </LinearLayout>
        <LinearLayout style="@style/OStat">
            <TextView android:id="@+id/statQty" style="@style/OStatVal" android:text="0" />
            <TextView style="@style/OStatLbl" android:text="Quantites" />
        </LinearLayout>
        <LinearLayout style="@style/OStat">
            <TextView android:id="@+id/statTotal" style="@style/OStatVal" android:text="0" />
            <TextView style="@style/OStatLbl" android:text="Total Ar" />
        </LinearLayout>
    </LinearLayout>

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bon de commande"
            android:textColor="#1F2733"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAddProduct"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/btn_primary"
            android:paddingHorizontal="18dp"
            android:text="+ Ajouter"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Liste produits -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/productsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="20dp"
            android:layoutAnimation="@anim/layout_fall_down">

            <TextView
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:gravity="center"
                android:text="Aucun produit\n\nAppuyez sur + Ajouter pour commencer"
                android:textColor="#6B7686"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Barre recapitulatif -->
    <LinearLayout
        android:id="@+id/summaryBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EEF1F6"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total General"
                android:textColor="#6B7686"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/grandTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Ar"
                android:textColor="#1E88E5"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnValidate"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:background="@drawable/btn_primary"
            android:paddingHorizontal="22dp"
            android:text="Valider la commande"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

    <include layout="@layout/bottom_nav" />

</LinearLayout>
